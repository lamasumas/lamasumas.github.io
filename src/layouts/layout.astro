---
import "../styles/global.css";

const site = Astro.site ?? new URL("https://lamasumas.github.io");
const title = "Eduardo Lamas | Full Stack Engineer";
const description =
  "Eduardo Lamas Suárez — Full Stack Engineer based in Tokyo. Java, Spring and Angular/TypeScript. Experience at CERN, Tap Co Ltd and Merkle.";
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og-image.png", site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Eduardo Lamas Suárez",
  jobTitle: "Full Stack Engineer",
  url: site.href,
  image: ogImage.href,
  sameAs: [
    "https://github.com/lamasumas",
    "https://www.linkedin.com/in/elamasu/",
    "https://www.instagram.com/the_hidden_spanish/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eduardo Lamas Suárez" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/Aprilea/Aprilea.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Champagne/Champagne_Limousines.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body class="antialiased bg-white text-gray-900">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-lg"
    >
      Skip to content
    </a>
    <main id="content">
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }
</style>

---
import ProjectCard from "./project-card.astro";

const projects = [
  {
    url: "https://jp.hal-bot.uk/",
    title: "JapLearn",
    description:
      "Self-hosted Japanese learning platform. Kanji and vocabulary dictionaries with JLPT levels, readings, meanings and example words, full-text search over 220k entries, and a swipe-based study mode.",
    technologies: [
      "Java",
      "Spring Boot",
      "PostgreSQL",
      "Flyway",
      "JWT",
      "React",
      "TypeScript",
      "Vite",
      "Tailwind",
      "Docker",
    ],
  },
  {
    url: "https://github.com/lamasumas/AI-Agora",
    title: "AI Agora",
    description:
      "Self-hosted personal workspace for notes, finances, kanban boards and scheduled cron tasks, built from the ground up to be shared with a personal AI agent such as Hermes, OpenClaw or Claude Code.",
    technologies: [
      "Python",
      "FastAPI",
      "SQLite",
      "React",
      "TypeScript",
      "Vite",
      "REST API",
      "Docker",
    ],
  },
  {
    url: "https://spaindevjobs.com/",
    title: "SpainDevJobs",
    description:
      "Job board connecting companies in Spain with local and international tech talent. Multilingual interface, job and application management, and company profiles.",
    technologies: [
      "Next.js",
      "React",
      "TypeScript",
      "Tailwind",
      "Supabase",
      "PostgreSQL",
      "i18n",
    ],
  },
  {
    url: "https://github.com/lamasumas/HAL-Server-Assistant",
    title: "HAL Server Assistant",
    description:
      "Chat room for a locally deployed LLM model in Ollama. This project is focused in low memory devices like raspberry pi.",
    technologies: [
      "Next.js",
      "LLM",
      "Ollama",
      "Tailwind",
      "Typescript",
      "SCSS",
    ],
  },
  {
    url: "https://github.com/lamasumas/lamasumas.github.io",
    title: "Portfolio Webpage",
    description:
      "This webpage, a professional portfolio to showcase my work and my career. github pages.",
    technologies: ["Astro", "Tailwind CSS"],
  },
  {
    url: "https://github.com/lamasumas/Machine_Learning",
    title: "Machine Learning Implementations",
    description:
      "The implementation of different machine learning algorithms, in order to practice and learn about this field.",
    technologies: [
      "Python",
      "Java",
      "Algorithm",
      "Processing",
      "Javascript",
      "AI",
    ],
  },
  {
    url: "https://github.com/lamasumas/Geofauna",
    title: "GeoFauna",
    description:
      "Phone application for helping biologists to record animal sightings along with environmental data. In addition to the app, there is an additional companion microcontroller for recording this extra data.",
    technologies: ["Kotlin", "Android", "ESP32", "Microcontroller", "C++"],
  },
  {
    url: "https://github.com/lamasumas/supabase-manager",
    title: "Supabase Manager - Spring Boot template",
    description:
      "Small template created for a quickstart in Spring Boot web projects, for accessing and handling Supabase in this case.",
    technologies: ["Spring Boot", "Java", "Supabase", "PostgreSQL"],
  },
  {
    url: "https://github.com/lamasumas/A-_Java",
    title: "A* Visualizer",
    description:
      "An implementation of the A* algorithm, with an interactive interface to play around.",
    technologies: ["Java", "Algorithm", "Processing"],
  },
  {
    url: "https://github.com/lamasumas/ECCO",
    title: "ECCO Green House Gas Emissions Calculator",
    description:
      "Energy Community Co-Operatives (ECCO), was a European project aimed to promote the adoption of renewable energies in small communities. This project was a module of the One-Stop shop developed for this project, which helps the user calculate the amount of CO2 produced in the implementation of one of the renewable energy options",
    technologies: ["Javascript", "HTML", "CSS", "Docker"],
  },
  {
    url: "https://github.com/lamasumas/PythonPersonalProjects",
    title: "Python Scripts",
    description:
      "Different scripts created in python that cover different topics/necessities I had. From a Reddit wallpaper liked post downloader, to machine learning",
    technologies: ["Python", "AI"],
  },
];
---

<section
  id="myProjects"
  class="w-full flex flex-col gap-5 min-h-0 max-h-130"
>
  <h2 class="text-3xl md:text-4xl flex section-title justify-center">
    My Side-Projects
  </h2>
  <div
    class="flex w-full flex-col gap-4 flex-1 min-h-0 overflow-y-auto lg:pr-2"
  >
    {
      projects.map((project) => (
        <ProjectCard
          url={project.url}
          title={project.title}
          description={project.description}
          technologies={project.technologies}
        />
      ))
    }
  </div>
</section>

---
interface Props {
  title: string;
  logos: Logo[];
}

export interface Logo {
  src: string;
  title: string;
  alt?: string;
  size?: "sm" | "md" | "lg" | "wide";
}

const { title, logos } = Astro.props;

const sizeMap: Record<NonNullable<Logo["size"]>, string> = {
  sm: "w-14 h-14 sm:w-16 sm:h-16",
  md: "w-18 h-18 sm:w-24 sm:h-24",
  lg: "w-24 h-24 sm:w-32 sm:h-32",
  wide: "w-32 h-16 sm:w-44 sm:h-20",
};
---

<div
  class="card-container relative border-2 border-black rounded-lg pt-8 w-full max-w-md"
>
  <div
    class="card-title absolute -top-4 left-4 bg-white px-2 text-2xl font-bold"
  >
    {title}
  </div>
  <div
    class="card-content grid grid-cols-2 gap-4 place-items-center p-4 h-full"
  >
    {
      logos.map((logo) => (
        <img
          src={logo.src}
          alt={logo.alt ?? logo.title}
          class:list={["object-contain", sizeMap[logo.size ?? "sm"]]}
          title={logo.title}
        />
      ))
    }
  </div>
</div>

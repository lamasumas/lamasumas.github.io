---
import javaLogo from "../../assets/java.svg";
import typescriptLogo from "../../assets/typescript.svg";
import angularLogo from "../../assets/angular.svg";
import springLogo from "../../assets/spring.svg";
import sqlLiteLogo from "../../assets/sqlite.svg";
import pythonLogo from "../../assets/python.svg";

import reactLogo from "../../assets/react_light.svg";
import tailwindLogo from "../../assets/tailwindcss.svg";
import postgresqlLogo from "../../assets/postgresql.svg";
import mongodbLogo from "../../assets/mongodb-icon-light.svg";
import rLogo from "../../assets/r.svg";

import astroLogo from "../../assets/astro.svg";
import supabaseLogo from "../../assets/supabase.svg";
import dockerLogo from "../../assets/docker.svg";
import kubernetesLogo from "../../assets/kubernetes.svg";
import kotlinLogo from "../../assets/kotlin.svg";

interface Logo {
  src: string;
  title: string;
}

const groups: { title: string; logos: Logo[] }[] = [
  {
    title: "Expert",
    logos: [
      { src: javaLogo.src, title: "Java" },
      { src: typescriptLogo.src, title: "TypeScript" },
      { src: angularLogo.src, title: "Angular" },
      { src: springLogo.src, title: "Spring" },
      { src: sqlLiteLogo.src, title: "SQLite" },
      { src: pythonLogo.src, title: "Python" },
      { src: reactLogo.src, title: "React" },
    ],
  },
  {
    title: "Proficient",
    logos: [
      { src: tailwindLogo.src, title: "Tailwind" },
      { src: postgresqlLogo.src, title: "PostgreSQL" },
      { src: mongodbLogo.src, title: "MongoDB" },
      { src: rLogo.src, title: "R" },
      { src: astroLogo.src, title: "Astro" },
    ],
  },
  {
    title: "Familiar",
    logos: [
      { src: supabaseLogo.src, title: "Supabase" },
      { src: dockerLogo.src, title: "Docker" },
      { src: kubernetesLogo.src, title: "Kubernetes" },
      { src: kotlinLogo.src, title: "Kotlin" },
    ],
  },
];
---

<section
  id="myTechStack"
  class="@container w-full flex flex-col gap-5 max-w-xl"
>
  <h2 class="text-3xl md:text-4xl flex justify-center section-title">
    My Tech Stack
  </h2>

  <div class="flex flex-col gap-5">
    {
      groups.map(({ title, logos }) => (
        <div class="flex flex-col gap-2">
          <h3 class="text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">
            {title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {logos.map((logo) => (
              <li class="flex items-center gap-2 rounded-full border border-gray-300 bg-gray-50 py-1 pl-1.5 pr-3">
                <img
                  src={logo.src}
                  alt=""
                  loading="lazy"
                  class="h-5 w-5 shrink-0 object-contain"
                />
                <span class="text-sm font-medium text-gray-800">
                  {logo.title}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

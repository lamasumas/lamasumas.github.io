---
import { Image } from "astro:assets";

interface Props {
  link: string;
  icon: any;
  text: string;
}

const { icon, link, text } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer">
  <Image
    src={icon}
    title={text}
    class="w-10 h-10 text-white sm:w-14 sm:h-14 md:w-14 md:h-14"
    alt={text}
  />
</a>

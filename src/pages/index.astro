---
import Experience from "../components/experience/experience.astro";
import MainMenu from "../components/homepage/homepage.astro";
import Technologies from "../components/technologies/technologies.astro";
import MyProjects from "../components/projects/my-projects.astro";
import Layout from "../layouts/layout.astro";
import SideMenu from "../components/menu/side-menu.astro";
import AboutMe from "../components/about/about.astro";
---

<Layout>
  <div class="flex">
    <SideMenu />
    <div class="flex flex-1 flex-col gap-4 pb-20 md:pb-0">
      <MainMenu />
      <div class="px-6 py-14 sm:px-10 sm:py-20">
        <div
          class="relative flex flex-col items-center gap-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-4"
        >
          <div
            class="contents lg:flex lg:flex-col lg:gap-10 lg:order-2 lg:max-w-none"
          >
            <div
              class="order-1 w-full flex justify-center max-w-md lg:max-w-none"
            >
              <Technologies />
            </div>
            <div class="order-3 w-full max-w-md lg:max-w-none">
              <MyProjects />
            </div>
          </div>
          <div
            class="order-2 lg:order-1 w-full flex max-w-md justify-center lg:max-w-none"
          >
            <Experience />
          </div>
        </div>
      </div>
      <AboutMe />
    </div>
  </div>
</Layout>

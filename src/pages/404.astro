---
import Layout from "../layouts/layout.astro";
---

<Layout>
  <section
    class="flex min-h-dvh flex-col items-center justify-center gap-6 px-4 text-center"
  >
    <p class="text-7xl font-bold section-title">404</p>
    <h1 class="text-2xl sm:text-3xl">This page wandered off.</h1>
    <p class="max-w-md text-gray-600">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="rounded-full bg-gray-900 px-6 py-2.5 font-medium text-white transition-colors hover:bg-gray-700"
    >
      Back home
    </a>
  </section>
</Layout>
